# Copy to .env and fill in. Never commit .env (it is git-ignored).
# Load it before starting the services:  set -a; source .env; set +a

# --- Model providers ---------------------------------------------------------
# Meta Model API: SAM 3.1 segmentation + Muse Spark extraction (both services)
META_API_KEY=your-meta-model-api-key
# Optional overrides
# META_BASE_URL=https://api.meta.ai/v1
# META_SAM_MODEL=sam-3.1
# META_MUSE_MODEL=muse-spark-1.3

# Baseten: Muse Spark Open purchase decisions (Medaffin agent only)
BASETEN_API_KEY=your-baseten-api-key
BASETEN_MODEL=meta-models/muse-spark-open-1026
# BASETEN_BASE_URL=https://inference.baseten.co/v1

# --- Shared between both services --------------------------------------------
# Admin token for agent registration and credit top-ups. Use the same value on
# the issuer and the Medaffin agent. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(24))"
MUDRIKA_ADMIN_TOKEN=change-me

# --- Issuer (seller) ---------------------------------------------------------
MUDRIKA_REDIS_URL=redis://localhost:6379/0
# Seed for the issuer's Ed25519 signing key (any long random string)
ISSUER_SIGNING_SEED=change-me-to-a-long-random-string
# MUDRIKA_SELLER_ID=demo-medical-council
# MUDRIKA_MATCH_COST=15
# MUDRIKA_DEMO=1            # 1 = allow the "simulate issuer outage" switch

# --- Medaffin agent (buyer) --------------------------------------------------
ISSUER_URL=http://localhost:8000
# Seed for the agent's Ed25519 signing key (any long random string). Keep it
# stable: the issuer pins the first public key it sees for this agent id.
AGENT_SIGNING_SEED=change-me-to-another-long-random-string
# MEDAFFIN_AGENT_ID=medaffin-onboarding-01
# MEDAFFIN_START_CREDITS=300

# --- Testing ------------------------------------------------------------------
# MUDRIKA_OFFLINE=1         # skip all model calls; regions come from the template layout
